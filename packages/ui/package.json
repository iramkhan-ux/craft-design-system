{
  "name": "@craft/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Craft React components and Storybook (pilot: Blade reference).",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs && node scripts/build-typography.mjs && node scripts/typography-checksum.mjs && node scripts/build-spacing.mjs && node scripts/build-elevation.mjs && node scripts/build-motion.mjs && node scripts/build-opacity-blur.mjs && node scripts/build-icon-size.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006",
    "build-storybook": "npm run tokens && storybook build",
    "typecheck": "npm run tokens && tsc --noEmit",
    "lint": "npm run tokens && eslint .",
    "test": "npm run tokens && vitest run",
    "visual": "npm run build-storybook && playwright test",
    "visual:update": "npm run build-storybook && playwright test --update-snapshots",
    "tokens:typography": "node scripts/typography-checksum.mjs",
    "docs:icon-size": "npm run tokens && node scripts/build-docs-icon-size.mjs",
    "docs:opacity-blur": "npm run tokens && node scripts/build-docs-opacity-blur.mjs",
    "docs:motion": "npm run tokens && node scripts/build-docs-motion.mjs",
    "docs:elevation": "npm run tokens && node scripts/build-docs-elevation.mjs",
    "docs:spacing": "npm run tokens && node scripts/build-docs-spacing.mjs",
    "docs:color": "node scripts/build-docs-color.mjs",
    "docs:typography": "npm run tokens && node scripts/build-docs-typography.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fontsource/tasa-orbiter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "http-server": "^14.1.1",
    "playwright": "^1.63.0",
    "storybook": "^10.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
