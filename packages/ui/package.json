{
  "name": "@craft/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Craft React components and Storybook (pilot: Blade reference).",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "storybook": "npm run tokens && storybook dev -p 6006",
